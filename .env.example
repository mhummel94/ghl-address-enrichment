# --- GoHighLevel ---
# Settings > Private Integrations > Create New Integration
# Required scopes: contacts.readonly, contacts.write, conversations.readonly,
# conversations/message.readonly
GHL_PIT_TOKEN=pit-xxxxxxxxxxxxxxxxxxxx
GHL_LOCATION_ID=your-location-id
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Service config ---
PORT=3000
LOOKBACK_HOURS=48
# If true, the service will NOT call update-contact; it will just return
# the extracted JSON so you can eyeball it before wiring up the write step.
DRY_RUN=true

# Simple shared-secret so Railway's public URL isn't wide open.
# Send this back as header: x-service-key
SERVICE_KEY=change-me
